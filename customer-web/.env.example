# Copy to .env.local and fill in. Never commit .env.local.

# Backend that stores quote requests (moveright-system server)
QUOTES_API_URL=https://moveright-api.onrender.com
# Must match WEBSITE_API_KEY in the backend's server/.env. Server-only: never prefix with NEXT_PUBLIC_
WEBSITE_API_KEY=change-me-to-the-same-key-as-the-backend
